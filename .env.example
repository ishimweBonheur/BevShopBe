DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret
SETUP_TOKEN=replace-with-a-random-first-owner-setup-token
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKUP_KEY=replace-with-64-hex-characters-generated-by-configure-backups
# Optional persistent backup destination. Default: ./backups
# BACKUP_DIR=P:/ShopBackups
# Set only when restoring to a separate empty database:
# RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/EMPTY_DATABASE?sslmode=require
